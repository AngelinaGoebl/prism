dtmc

module M

s:[0..5] init 0;

[] s=0 -> [0.5,0.5]:(s'=1) + [0.5,0.5]:(s'=2);
[r] s=1 -> [1,1]:(s'=3);
[] s=2 -> [0.5,0.5]:(s'=1) + [0.5,0.5]:(s'=3);
[] s=3 -> [0.2,0.6]:(s'=4) + [0.4,0.8]:(s'=5);
[] s=4 -> [1,1]:(s'=4);
[] s=5 -> [0.3,0.3]:(s'=5) + [0.7,0.7]:(s'=4);


endmodule

rewards "time"
true : 1;
endrewards

rewards "r"
s=4 : 3;
[r] true : 17;
endrewards