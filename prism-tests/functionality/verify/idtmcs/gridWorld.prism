dtmc

// Grid dimensions (10x0 grid)
const int M = 4;
const int N = 2;


module robot
  // Robot1’s state: position (x,y) and failure flag f1.
  x : [0..M] init 2;
  y : [0..N] init 0;

 // middle states
  []  x < M & 0<x & y < N & 0 < y -> [0.2,0.4]: (x'=x) & (y' =y+1) + [0.2,0.4]: (x'=x) & (y' =y-1) +  [0.2,0.4]: (x'=x+1) & (y' =y) + [0.2,0.4]: (x'=x-1) & (y' =y) ;

  // y on wall
  []  x < M & 0<x & y = N ->  [0.2,0.4]: (x'=x) & (y' =y-1) +  [0.2,0.4]: (x'=x+1) & (y' =y) + [0.2,0.4]: (x'=x-1) & (y' =y) ;
  []  x < M & 0<x & y = 0 ->  [0.2,0.4]: (x'=x) & (y' =y+1) +  [0.2,0.4]: (x'=x+1) & (y' =y) + [0.2,0.4]: (x'=x-1) & (y' =y) ;

  //corners
  []  x =M & y = N ->  [1.0,1.0]: (x' =x) & (y' = y) ;
  []  x = M & y = 0 -> [0.4,0.6]: (x'=x) & (y' =y+1) +  [0.4,0.6]: (x'=x-1) & (y' =y) ;
  []  x =0 & y = N ->  [0.4,0.6]: (x'=x) & (y' =y-1) + [0.4,0.6]: (x'=x+1) & (y' =y) ;
  []  x = 0 & y = 0 -> [0.4,0.6]: (x'=x) & (y' =y+1) +  [0.4,0.6]: (x'=x+1) & (y' =y) ;

   []  x=M & y < N & 0 < y ->  [0.2,0.4]: (x'=x) & (y' =y-1) +  [0.2,0.4]: (x'=x) & (y' =y+1) + [0.2,0.4]: (x'=x-1) & (y' =y) ;
   []  x=0 & y < N & 0 < y ->  [0.2,0.4]: (x'=x) & (y' =y-1) +  [0.2,0.4]: (x'=x) & (y' =y+1) + [0.2,0.4]: (x'=x+1) & (y' =y) ;

endmodule