dtmc

const double p=0.5;
const double eps=0.05;

module die1

	// local state
	s1 : [0..7] init 0;
	// value of the die
	d1 : [0..6] init 0;

	[flip] s1=0 -> [p - eps, p + eps] : (s1'=1) + [1 - p - eps, 1 - p + eps]  : (s1'=2);
	[flip] s1=1 -> [p - eps, p + eps] : (s1'=3) + [1 - p - eps, 1 - p + eps]  : (s1'=4);
	[flip] s1=2 -> [p - eps, p + eps] : (s1'=5) + [1 - p - eps, 1 - p + eps]  : (s1'=6);
	[flip] s1=3 -> [p - eps, p + eps] : (s1'=1) + [1 - p - eps, 1 - p + eps]  : (s1'=7) & (d1'=1);
	[flip] s1=4 -> [p - eps, p + eps] : (s1'=7) & (d1'=2) + [1 - p - eps, 1 - p + eps]  : (s1'=7) & (d1'=3);
    [flip] s1=5 -> [p - eps, p + eps] : (s1'=7) & (d1'=4) + [1 - p - eps, 1 - p + eps]  : (s1'=7) & (d1'=5);
    [flip] s1=6 -> [p - eps, p + eps] : (s1'=2) + [1 - p - eps, 1 - p + eps]  : (s1'=7) & (d1'=6);
	[flip] s1=7 -> (s1'=0) & (d1'=0);

endmodule

formula uneven = (d1=1 | d1=3 | d1=5);
formula even = (d1=2 | d1=4 | d1=6);

label "uneven" = uneven;
label "even" = even;